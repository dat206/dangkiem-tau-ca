$.validator.addMethod("validatedecimalnotnegative", function (value, element, params) {

    var regex = /^\s*(?=.*[0-9])\d*(?:\.\d{1,2})?\s*$/;
    var gia = $(params).val();
    if (regex.test(gia)) {
        return true;
    }
    else {
        return false;
    }
    
    return true;
});

